          }),
          dict({
            'cards': list([
              dict({
                'heading': 'Hvorfor denne planen?',
                'type': 'heading',
              }),
              dict({
                'content': '''
                  {%- set e = "sensor.sauna_plan_status" -%}
                  {%- set id = "sauna" -%}
                  {%- set a = states[e].attributes if states[e] is defined else {} -%}
                  {%- set slots = state_attr("sensor.home_plan", 'slots') or [] -%}
                  {%- macro n(x) -%}{{ ('%.2f' | format(x)) | replace('.', ',') }}{%- endmacro -%}
                  {%- macro sn(x) -%}{{ ('%+.2f' | format(x)) | replace('.', ',') | replace('-', '−') }}{%- endmacro -%}
                  {%- set ns = namespace(runs=[], cs=none, ce=none) -%}
                  {%- for s in slots if (s.planned_kwh or {}).get(id, 0) > 0 -%}
                  {%- if ns.ce == s.start -%}{%- set ns.ce = s.end -%}
                  {%- else -%}
                  {%- if ns.cs -%}{%- set ns.runs = ns.runs + [[ns.cs, ns.ce]] -%}{%- endif -%}
                  {%- set ns.cs = s.start -%}{%- set ns.ce = s.end -%}
                  {%- endif -%}
                  {%- endfor -%}
                  {%- if ns.cs -%}{%- set ns.runs = ns.runs + [[ns.cs, ns.ce]] -%}{%- endif -%}
                  {%- set hm = '%H:%M' -%}
                  {%- set strategy = {"always": "Alltid på", "arbitrage": "Kjøp billig, selg dyrt", "best_save": "Spar der det svir minst", "cheapest_hours": "Billigste timer", "deadline_fill": "Billigste timer før fristen", "heat_capacitor": "Lagre varme i billige timer", "observe": "Prøvemodus", "opportunistic": "Bare når det er billig", "peak_shave": "Kapp toppene", "run_once": "Én kjøring før klartid", "schedule": "Følg en tidsplan"} -%}
                  {%- set conf = {"known": "kjente priser", "stale": "gamle priser", "estimated": "anslåtte priser", "synthesised": "syntetiske priser"} -%}
                  <ha-icon icon="mdi:clock-check-outline"></ha-icon> **Behov:** {{ n(a.planned_kwh | float(0)) }} kWh{{ (' ' ~ 'før ' ~ (a.deadline | as_timestamp | timestamp_custom(hm)) ~ '') if a.deadline }}
                  
                  <ha-icon icon="mdi:weather-night"></ha-icon> **Valgt tid:** {% for s, en in ns.runs %}{{ s | as_timestamp | timestamp_custom(hm) }}–{{ en | as_timestamp | timestamp_custom(hm) }}{{ ', ' if not loop.last }}{% else %}ingen kjøring planlagt{% endfor %}
                  
                  <ha-icon icon="mdi:check-circle-outline"></ha-icon> **Dekning:** {{ ((a.coverage | float(0)) * 100) | round(0) | int }} % · {{ conf.get(a.confidence, a.confidence) }}
                  
                  <ha-icon icon="mdi:cash"></ha-icon> **Anslått kostnad:** ≈ {{ n((a.cost or '0').split(' ')[0] | float(0)) }} kr · {{ strategy.get(a.strategy, a.strategy) }}
                ''',
                'grid_options': dict({
                  'columns': 'full',
                  'rows': 'auto',
                }),
                'type': 'markdown',
              }),
            ]),
            'column_span': 2,
            'type': 'grid',
          }),
          dict({
            'cards': list([
              dict({
